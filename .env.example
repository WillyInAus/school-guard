# Copy this file to .env and fill in real values before running
# docker compose up -d --build
#
# Avoid the "$" character in any value below -- Docker Compose treats it as
# the start of a variable reference when reading this file, which silently
# mangles the value.

# Password for the school's Postgres database inside the "db" container.
# Pick a strong value - it never needs to be typed anywhere except here.
POSTGRES_PASSWORD=changeme

# Long random value used to sign staff sign-in sessions. Generate one with:
#   openssl rand -hex 32
# Changing this later signs everyone out at once (existing sessions stop
# verifying) but doesn't affect anyone's stored password.
SESSION_SECRET=changeme

# Staff accounts (name, email, password, role) are created from inside the
# app itself -- see /admin/setup the first time you run it, then Admin ->
# Manage staff after that. There's no separate admin password to set here
# any more.
